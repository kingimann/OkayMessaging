<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The one thing this extension shares with the app: the per-contact
	     preview keys. Same group string on both sides or the lookup finds
	     nothing and every banner silently keeps its fallback body. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.okaymessaging.shared</string>
	</array>
</dict>
</plist>
