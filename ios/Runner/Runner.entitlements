<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.messaging-app</key>
	<true/>
	<key>com.apple.developer.calling-app</key>
	<true/>
	<!-- NFC tag reading. Must be TAG, not NDEF: the Xcode 26 SDK at min-iOS 13
	     rejects the NDEF reader format on upload (error 90778) and demands TAG.
	     NfcPay.swift reads/writes NDEF through the tag protocol accordingly. -->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
	<!-- Shared with the NotificationService extension, and holding exactly one
	     kind of thing: the per-contact keys that let the extension open a
	     sealed push preview. Without a shared group the extension has its own
	     keychain, finds no key, and every banner keeps its content-free
	     fallback. Same string in NotificationService.entitlements. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.okaymessaging.shared</string>
	</array>
</dict>
</plist>
