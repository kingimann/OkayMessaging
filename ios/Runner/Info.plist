<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>NSCameraUsageDescription</key>
		<string>OkayMessenger needs the camera for video calls.</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>OkayMessenger needs the microphone for voice and video calls.</string>
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>OkayMessenger uses your location to show you on the map, share places, and give directions.</string>
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>OkayMessenger uses your location to show you on the map, share places, and give directions.</string>
		<key>NSContactsUsageDescription</key>
		<string>OkayMessenger checks your contacts to show which of them already use the app so you can message and call them. Your contacts are never uploaded.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>OkayMessenger needs access to your photos so you can send pictures and set your profile photo.</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>OkayMessenger needs permission to save photos and videos you receive to your library.</string>
		<!--
		  Export compliance. OkayMessenger uses only standard, published
		  encryption (AES-256-GCM, PBKDF2, HKDF for the encrypted sync, plus
		  HTTPS) — no proprietary crypto — which qualifies for the mass-market
		  exemption, so no non-exempt encryption is used. Declaring this here
		  stops App Store Connect asking the compliance question on every build.
		-->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>OkayMessenger</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>okay_messaging</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLName</key>
				<string>com.okaymessaging.im</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>im</string>
					<string>tel</string>
				</array>
			</dict>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLName</key>
				<string>com.okaymessaging.payments</string>
				<!-- Stripe Connect onboarding hands control to Safari and comes
				     back through this scheme (payments-onboard's return_url).
				     Without it the KYC flow dead-ends on the last page. -->
				<key>CFBundleURLSchemes</key>
				<array>
					<string>okaymsg</string>
				</array>
			</dict>
		</array>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>NSBluetoothAlwaysUsageDescription</key>
		<string>OkayMessenger uses Bluetooth to send messages directly to people near you when there is no internet, and to pass on messages for others. Everything it carries is already encrypted — this device cannot read what it relays.</string>
		<key>NSLocalNetworkUsageDescription</key>
		<string>OkayMessenger uses the local network to send photos directly to a person standing next to you, over a link between the two devices. Nothing is uploaded and no server is involved.</string>
		<key>NSBonjourServices</key>
		<array>
			<string>_okay-nearby._tcp</string>
			<string>_okay-nearby._udp</string>
		</array>
		<key>UIBackgroundModes</key>
		<array>
			<string>audio</string>
			<string>bluetooth-central</string>
			<string>bluetooth-peripheral</string>
			<string>remote-notification</string>
			<string>voip</string>
		</array>
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict>
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>UIWindowScene</string>
						<key>UISceneConfigurationName</key>
						<string>flutter</string>
						<key>UISceneDelegateClassName</key>
						<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
						<key>UISceneStoryboardFile</key>
						<string>Main</string>
					</dict>
				</array>
			</dict>
		</dict>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UIStatusBarHidden</key>
		<false/>
	</dict>
</plist>
